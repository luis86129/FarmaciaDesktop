<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.LoginController"
      alignment="CENTER" spacing="15" styleClass="root-container">

    <Label text="Iniciar Sesión" styleClass="title-label" />

    <TextField fx:id="txtEmail" promptText="Correo electrónico" styleClass="input-field" />
    <PasswordField fx:id="txtPassword" promptText="Contraseña" styleClass="input-field" />

    <Label fx:id="lblError" styleClass="error-label" visible="false" managed="false" />

    <Button text="Ingresar" styleClass="btn-primary" onAction="#onLogin" />
    <Button text="Volver al Menú" styleClass="btn-link" onAction="#goBack" />
</VBox>