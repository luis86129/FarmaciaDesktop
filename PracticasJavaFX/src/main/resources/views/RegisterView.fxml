<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.RegisterController"
      alignment="CENTER" spacing="12" styleClass="root-container">

    <Label text="Crear Cuenta" styleClass="title-label" />

    <TextField fx:id="txtNombre" promptText="Nombre completo" styleClass="input-field" />
    <TextField fx:id="txtEmail" promptText="Correo electrónico" styleClass="input-field" />
    <PasswordField fx:id="txtPassword" promptText="Contraseña" styleClass="input-field" />

    <Label fx:id="lblStatus" styleClass="error-label" visible="false" managed="false" />

    <Button text="Registrar" styleClass="btn-primary" onAction="#onRegister" />
    <Button text="Volver al Menú" styleClass="btn-link" onAction="#goBack" />
</VBox>